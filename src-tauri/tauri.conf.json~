{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomeroy",
  "version": "0.1.0",
  "identifier": "com.pomeroy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pomeroy",
        "label": "main",
        "width": 440,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Pomodoro timer with project/task logging",
    "longDescription": "Pomeroy is a cross-platform Pomodoro timer that runs in the background and logs each focus session against a project and tasks into local monthly JSON files."
  },
  "plugins": {}
}
